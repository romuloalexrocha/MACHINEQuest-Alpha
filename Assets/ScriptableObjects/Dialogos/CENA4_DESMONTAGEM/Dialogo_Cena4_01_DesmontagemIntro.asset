  linhasDialogo:
  - falaPersonagem: "Excelente. Agora precisamos desmontar a carca\xE7a do redutor
      para verificar o que est\xE1 causando o problema. Para isso, precisamos de
      uma chave adequada."
    spritePersonagem: {fileID: 21300000, guid: f282ac153a1507d4b9663de7d7b7d1a3, type: 3}
  - falaPersonagem: "Clique no bot\xE3o no topo da tela escrito MESA FERRAMENTAS.
      L\xE1 voc\xEA vai ter v\xE1rias ferramentas sobre a mesa, precisamos da Chave
      Allen."
    spritePersonagem: {fileID: 21300000, guid: f282ac153a1507d4b9663de7d7b7d1a3, type: 3}
