  etapa: 6
  linhasDialogo:
  - falaPersonagem: "Tudo no lugar! Agora precisamos testar o equipamento para garantir
      que o funcionamento est\xE1 100%."
    spritePersonagem: {fileID: 21300000, guid: c57bf43218e482a459a133201d8bd284, type: 3}
  - falaPersonagem: "Est\xE1 vendo a botoeira na mesa? Essa com dois bot\xF5es, um
      VERDE e um VERMELHO. Clique no bot\xE3o VERDE, por favor."
    spritePersonagem: {fileID: 21300000, guid: c57bf43218e482a459a133201d8bd284, type: 3}
  - falaPersonagem: "Uma vez ligado, teremos um diagn\xF3stico do Redutor com a quantidade
      de rota\xE7\xF5es por minuto (RPM) e o status (se aparecer verde, est\xE1 ok,
      sen\xE3o, ainda falta algo para verificar...)"
    spritePersonagem: {fileID: 21300000, guid: c57bf43218e482a459a133201d8bd284, type: 3}
