  m_Script: {fileID: 11500000, guid: 6bacc3a3f47127c46926fb218826dafa, type: 3}
  m_Name: Dialogo_Introducao
  m_EditorClassIdentifier: Assembly-CSharp::DialogoDados
  linhasDialogo:
  - nomePersonagem: "S\xE9rgio"
    falaPersonagem: "Ol\xE1! Voc\xEA deve ser o novo contratado... Me chamo S\xE9rgio,
      \xE9 um prazer te conhecer. Voc\xEA ir\xE1 trabalhar na \xE1rea de manuten\xE7\xE3o
      de redutores, venha comigo."
    spritePersonagem: {fileID: 0}
  - nomePersonagem: "S\xE9rgio"
    falaPersonagem: "Aqui \xE9 onde voc\xEA ir\xE1 trabalhar. Para o trabalho de
      hoje, temos que identificar um problema: o redutor n\xE3o est\xE1 funcionando
      corretamente e precisamos desmont\xE1-lo para verificar."
    spritePersonagem: {fileID: 0}
  - nomePersonagem: "S\xE9rgio"
    falaPersonagem: "Aqui est\xE1 uma prancheta com os poss\xEDveis problemas. Voc\xEA
      deve identificar o defeito e marc\xE1-lo nela. Ela ficar\xE1 no canto inferior
      esquerdo da sua tela. Venha, vou te ensinar."
    spritePersonagem: {fileID: 0}
